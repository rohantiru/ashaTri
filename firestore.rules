rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isCoordinator() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'coordinator';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Users collection
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']))
        || isCoordinator();
      allow delete: if isCoordinator();
    }

    // Swag items
    // - Coordinators have full write access
    // - Athletes can only update the inventory field (for order/cancel transactions)
    match /swagItems/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isCoordinator();
      allow update: if isCoordinator() ||
        (isSignedIn() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['inventory']));
    }

    // Swag responses
    // - Athletes can create their own with status 'interested' (interest polls)
    //   or 'ordered' (inventory items)
    // - Athletes can delete their own if still interested or ordered (not yet ready)
    // - Coordinators can read all and update status
    match /swagResponses/{responseId} {
      allow read: if isSignedIn() &&
        (resource.data.athleteId == request.auth.uid || isCoordinator());
      allow create: if isSignedIn() &&
        request.resource.data.athleteId == request.auth.uid &&
        (request.resource.data.status == 'interested' ||
         request.resource.data.status == 'ordered');
      allow update: if isCoordinator();
      allow delete: if isSignedIn() &&
        resource.data.athleteId == request.auth.uid &&
        (resource.data.status == 'interested' || resource.data.status == 'ordered');
    }
  }
}
